<odoo>

    <!-- Inherit Partner Form View -->
    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.approved.products</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="supplier_rank" invisible="1" />
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_approved_products"
                    icon="fa-check-circle"
                    invisible="supplier_rank == 0"
                >
                    <field
                        string="Approved Products"
                        name="approved_product_count"
                        widget="statinfo"
                    />
                </button>
            </div>
        </field>
    </record>

    <!-- Inherit Partner Form View - Sales & Purchase Tab -->
    <record id="view_partner_supplier_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.supplier.form.inherit.approved.products</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="purchase.view_partner_property_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='purchase']" position="inside">
                <group
                    string="Approved Products"
                    groups="purchase_supplier_approved.group_manage_approved_suppliers"
                >
                    <field name="approved_product_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="product_tmpl_id" />
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="active" />
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
